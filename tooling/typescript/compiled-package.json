{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    /** Emit types for internal packages to speed up editor performance. */
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "${configDir}/dist",
    /**
     * TS 6 defaults `rootDir` to the tsconfig's directory instead of
     * inferring it, which would emit to dist/src/*. Pin it so the
     * declarations keep landing at dist/* (package.json `types` exports).
     */
    "rootDir": "${configDir}/src"
  }
}
